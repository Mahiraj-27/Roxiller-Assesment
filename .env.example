# ==============================================================================
# RateSphere Backend Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Render / Cloud / Local PostgreSQL)
# When deployed to Render or Supabase, set DATABASE_URL:
# DATABASE_URL=postgresql://username:password@hostname:5432/ratesphere_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ratesphere_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Authentication Secrets
# Generate secure random strings: openssl rand -hex 32
JWT_SECRET=your_jwt_access_secret_key_min_32_characters_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters_here
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS)
CLIENT_URL=http://localhost:5173
